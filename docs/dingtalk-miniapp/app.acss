page{background:#F3F6F7;color:#18383F;font-family:system-ui,sans-serif}.screen{padding:24rpx 28rpx 60rpx}.hero{padding:30rpx 4rpx}.eyebrow{font-size:23rpx;color:#62797F;letter-spacing:4rpx}.title{font-size:48rpx;font-weight:700;margin-top:12rpx}.subtitle{font-size:25rpx;color:#62797F;line-height:1.7;margin-top:14rpx}.card{background:white;border-radius:22rpx;padding:28rpx;margin:20rpx 0;border:1rpx solid #E2E9E9}.row{display:flex;justify-content:space-between;align-items:center}.name{font-size:33rpx;font-weight:600}.meta{font-size:24rpx;color:#62797F;margin-top:12rpx;line-height:1.6}.message{font-size:29rpx;line-height:1.8;margin-top:22rpx;white-space:pre-wrap;word-break:break-word}.badge{background:#E6F3EF;color:#14745D;padding:6rpx 16rpx;border-radius:25rpx;font-size:22rpx}.error{background:#FFF0E8;color:#9C471F;padding:24rpx;border-radius:18rpx;line-height:1.7}button{margin-top:18rpx;border-radius:15rpx;font-size:29rpx}button.primary{background:#087F63;color:white}button.secondary{background:white;color:#194B57;border:1rpx solid #BCD0D5}.empty{text-align:center;padding:80rpx 20rpx;color:#62797F;line-height:1.8}.label{font-size:23rpx;color:#62797F;margin-bottom:8rpx}.value{font-size:30rpx;word-break:break-word}.footnote{font-size:23rpx;color:#62797F;line-height:1.6;margin-top:24rpx}

.details{margin:0 0 0 12rpx;flex-shrink:0}

.section-title{font-size:29rpx;font-weight:700;margin:26rpx 0 8rpx}

.listing{margin-top:22rpx;padding:20rpx;background:#F3F6F7;border-radius:14rpx}
